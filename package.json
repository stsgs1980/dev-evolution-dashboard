{
  "author": "stsgs1980",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@react-stately/utils": "^3.12.1",
    "@untitledui/file-icons": "^0.0.9",
    "@untitledui/icons": "^0.0.23",
    "input-otp": "^1.5.0",
    "octokit": "^5.0.5",
    "react": "^19.2.8",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "react-stately": "^3.51.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "zod": "^4.6.7"
  },
  "description": "Personal GitHub evolution dashboard: eras, DMI and craft metrics from a committed snapshot",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "8.0.3",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^5.0.4",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsdoc": "^65.2.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1",
    "next": "^16.4.2",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "keywords": [
    "dashboard",
    "github",
    "analytics",
    "nextjs",
    "react-aria",
    "untitled-ui"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs,mts,cts,json,html,md,vue,svelte,astro,scss,css,less,yaml}": "prettier --write",
    "*.{js,ts,jsx,tsx,mjs,cjs,mts,cts}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.{css,scss}": "stylelint --fix",
    "*.md": "markdownlint --fix --ignore node_modules"
  },
  "name": "dev-evolution-dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules",
    "check:file-length": "node scripts/check-file-length.ts --all",
    "check:docs": "node scripts/check-docs.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "changelog": "node scripts/generate-changelog.ts",
    "data:collect": "node --env-file-if-exists=.env.local --import tsx scripts/collect-github.ts",
    "data:validate": "node --import tsx scripts/validate-snapshot.ts"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.0"
  },
  "type": "module",
  "overrides": {
    "katex": "^0.19.0",
    "smol-toml": "^1.9.1",
    "js-yaml": "^5.4.3"
  },
  "version": "0.1.0"
}
